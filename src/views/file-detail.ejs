<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h1>File Details</h1>
    <ul>
      <li><strong>Name:</strong> <%= file.name.split(".")[0]  %></li>
      <li><strong>Type:</strong> <%= file.fileType.split("/")[1]  %></li>
      <li><strong>Size:</strong> <%= `${(file.size / (1024 * 1024)).toFixed(3)} MB`  %></li>
      <li><strong>Upload Date:</strong> <%=  new Date(file.uploadDate).toLocaleString()  %></li>
    </ul>
    <a href="<%= downloadUrl  %>">download</a>
    <div>
      <form action="/go-back" method="POST">
        <input type="hidden" name="previousUrl" value="<%= typeof previousUrl !== 'undefined' ? previousUrl : '/' %>">
        <button type="submit">go back</button>
      </form>
    </div>
  </body>
</html>
