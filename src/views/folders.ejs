<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h1><%= !locals.isUpdate ? "New" : "Update"  %> Folder</h1>
    <form action="/folders<%= folderId ?  `/${folderId}` : ""  %><%= !locals.isUpdate ? "" : "/update"  %>" method="POST">
      <label for="name">Folder Name:</label>
      <input type="text" name="name" id="name" value="<%= locals.folderName || ""  %>" />
      <button type="submit">Submit</button>
    </form>
    <form action="/go-back" method="POST">
        <input type="hidden" name="previousUrl" value="<%= typeof previousUrl !== 'undefined' ? previousUrl : '/' %>">
        <button type="submit">go back</button>
      </form>
  </body>
</html>
