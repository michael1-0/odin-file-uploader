<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css">
    <title>Upload File</title>
  </head>
  <body>
    <div class="auth-container">
      <div class="auth-header">
        <h2>📤 Upload File</h2>
        <p style="color: var(--text-secondary); font-size: 0.95rem;">EJS is pain</p>
      </div>
      
      <% if (error) { %>
        <div class="error-messages">
          <ul>
            <li><%= error %></li>
          </ul>
        </div>
      <% } %>
      
      <form action="/files<%= `?containingFolder=${folderId ? folderId : -1}` %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="previousUrl" value="<%= typeof previousUrl !== 'undefined' ? previousUrl : '/' %>">
        <div class="form-group">
          <label for="userFile">Choose File</label>
          <input type="file" name="userFile" id="userFile" required />
        </div>
        <button type="submit" class="btn-primary">Upload File</button>
      </form>
      
      <form action="/go-back" method="POST" style="margin-top: 1rem;">
        <input type="hidden" name="previousUrl" value="<%= typeof previousUrl !== 'undefined' ? previousUrl : '/' %>">
        <button type="submit" class="btn">← Go Back</button>
      </form>
    </div>
  </body>
</html>
