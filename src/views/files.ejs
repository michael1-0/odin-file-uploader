<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h1>Uploading file...</h1>
    <% if (error) { %>
      <div>
        <%= error %>
      </div>
    <% } %>
    <form action="/files<%= `?containingFolder=${folderId ? folderId : -1}`  %>" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="previousUrl" value="<%= typeof previousUrl !== 'undefined' ? previousUrl : '/' %>">
      <input type="file" name="userFile" required />
      <button type="submit">Submit file</button>
    </form>
    <form action="/go-back" method="POST">
        <input type="hidden" name="previousUrl" value="<%= typeof previousUrl !== 'undefined' ? previousUrl : '/' %>">
        <button type="submit">go back</button>
      </form>
  </body>
</html>
