generator client {
  provider = "prisma-client"
  output   = "../src/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String   @db.VarChar(60)
  folders  Folder[]

  @@map("users")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@map("sessions")
}

model Folder {
  id   Int    @id @default(autoincrement())
  name String

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  parentId     Int?
  parentFolder Folder?  @relation("ParentFolderSubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  subFolder    Folder[] @relation("ParentFolderSubFolders")

  @@map("folders")
}
